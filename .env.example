# Example environment variables for UK Immigration Data Extraction Pipeline
# Copy this file to .env and modify as needed

# API Configuration
API_BASE_URL=https://www.gov.uk/api/content
API_RATE_LIMIT=2.0
API_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_BACKOFF=2.0
API_RETRY_MAX_DELAY=60

# Processing Configuration
PROCESSING_BATCH_SIZE=50
PROCESSING_MAX_WORKERS=4
ENABLE_PARALLEL_PROCESSING=true
PDF_TIMEOUT=120
HTML_PARSER=lxml

# Quality Configuration
MIN_SUCCESS_RATE=0.95
MAX_FAILURE_RATE=0.10
ENCODING_VALIDATION=true
CONTENT_VALIDATION=true
STRUCTURE_VALIDATION=true

# Output Configuration
OUTPUT_FORMAT=jsonl
OUTPUT_DIRECTORY=output
OUTPUT_FILENAME=uk_immigration_data.jsonl
INCLUDE_METADATA=true
PRETTY_PRINT=false
OUTPUT_CHUNK_SIZE=1000

# Compliance Configuration
INCLUDE_LICENSING=true
INCLUDE_ATTRIBUTION=true
INCLUDE_CROWN_COPYRIGHT=true

# General Settings
DEBUG=false
VERBOSE=false
DRY_RUN=false
LOG_LEVEL=INFO
LOG_DIR=logs
ENDPOINTS_FILE=discovered_endpoints.json